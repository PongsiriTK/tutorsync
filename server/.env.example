# TutorSync API — copy to .env (gitignored). Bun auto-loads it.

# --- Email OTP (Resend) ---
# Get a key at https://resend.com (API Keys). When set, sign-in codes are
# emailed and NOT returned in the API response. Without it, the server falls
# back to returning the code (demo mode).
RESEND_API_KEY=

# Sender. Default onboarding@resend.dev only delivers to the Resend account
# owner's own address; to email anyone, verify a domain in Resend and use it:
#   TS_MAIL_FROM=TutorSync 🗓️ <noreply@yourdomain.com>
TS_MAIL_FROM=

# Debug: also return the code in the response even when emailing (default off).
# TS_EXPOSE_OTP=1
# Pretend-send without calling Resend (tests / UX preview). Do not use in prod.
# TS_MAIL_FAKE=1

# --- AI planning agent (MaxPlus AI · GLM 5.2) ---
# Powers the in-app assistant ("น้องซิงก์"). The key stays server-side; the
# client calls POST /ai/chat which proxies to MaxPlus. Without it, /ai/chat
# returns 503 and the app falls back to its offline heuristic assistant.
# Get a key at https://maxplus-ai.cc/docs/api
MAXPLUS_API_KEY=
# Optional overrides (defaults shown):
# MAXPLUS_BASE_URL=https://api.maxplus-ai.cc/deepseek/v1
# MAXPLUS_MODEL=glm-5.2

# --- Core (already set on jarvis via launchd) ---
# PORT=8791
# TS_DB=./data/tutorsync.sqlite
# TS_JWT_SECRET=<random>
